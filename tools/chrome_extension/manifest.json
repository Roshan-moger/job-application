{
  "manifest_version": 3,
  "name": "AI Job Auto-Apply & Form Filler",
  "version": "1.0.0",
  "description": "1-Click automated job application form auto-filler for LinkedIn, Naukri, Indeed, Greenhouse, Lever, Workday, and ATS portals.",
  "author": "Roshan Moger",
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Job Auto-Apply (Roshan Moger)",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
